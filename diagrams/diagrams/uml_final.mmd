classDiagram
    %% ================= Core Domain (pawpal_system.py) =================
    class Owner {
        +str name
        +int available_minutes
        +str preferences
        +get_available_minutes() int
    }

    class Pet {
        +str name
        +str species
        +int age
        +str breed
        +str special_needs
        +list~Task~ tasks
        +add_task(task) void
    }

    class Task {
        +str title
        +int duration_minutes
        +str priority
        +str recurrence
        +str notes
        +bool completed
        +bool owner_required
        +date last_completed_date
        +str preferred_time
        +str concurrent_group
        +is_high_priority() bool
        +is_due(today) bool
        +mark_complete(on_date) void
        +apply_edit(...) void
    }

    %% ================= Scheduling: multi-pet (primary path, used by app.py/main.py) =================
    class MultiPetScheduler {
        +Owner owner
        +list~tuple~ pet_tasks
        +generate_plan(today) MultiPetPlan
    }

    class MultiPetPlan {
        +list~tuple~ scheduled_slots
        +int total_owner_minutes
        +list~tuple~ unscheduled
        +list~tuple~ missed_anchors
        +add_slot(time, pet, task, background, count_minutes) void
    }

    class ConflictDetection {
        <<utility functions>>
        +find_time_conflicts(pet_tasks, today) list
        +confirm_concurrent_group(group) void
        +unscheduled_minutes_needed(unscheduled) int
    }

    %% ================= Scheduling: single-pet (legacy path, still unit-tested) =================
    class Scheduler {
        +Owner owner
        +Pet pet
        +list~Task~ tasks
        +sort_tasks(tasks) list
        +filter_by_time(available_minutes, tasks) tuple
        +generate_plan(today) DailyPlan
    }

    class DailyPlan {
        +list~tuple~ scheduled_slots
        +int total_minutes_used
        +list~str~ reasoning
        +list~Task~ unscheduled
        +add_slot(time, task) void
        +display() str
        +get_summary() str
    }

    %% ================= AI subsystem (ai/) =================
    class LLMClient {
        <<interface>>
        +generate(prompt) str
    }

    class GeminiClient {
        +generate(prompt) str
    }

    class TaskParser {
        <<ai.parser>>
        +parse_pet_description(text, llm_client) ParsedPetResult
        +parse_tasks_from_description(text, pet, llm_client) ParsedTaskBatchResult
        +suggest_tasks_for_pet(pet, llm_client, count) ParsedTaskBatchResult
    }

    class ParsedPetResult {
        +Pet pet
        +list warnings
        +str error
    }

    class ParsedTaskBatchResult {
        +list~Task~ tasks
        +list warnings
        +list dropped
        +str error
    }

    class GuardrailValidator {
        <<ai.guardrails>>
        +validate_task_fields(data, corpus_context) ValidationResult
        +validate_pet_fields(data) ValidationResult
    }

    class ValidationResult {
        +bool ok
        +dict cleaned
        +list issues
    }

    class CareCorpus {
        <<ai.corpus>>
        +retrieve(species, query_text, top_k) list
        +load_corpus(path) list
    }

    class PetPhotoService {
        <<ai.pet_photos>>
        +get_pet_photo_url(pet) str
    }

    %% ================= Relationships =================
    Pet "1" *-- "*" Task : owns
    GeminiClient ..|> LLMClient : implements

    MultiPetScheduler --> Owner : uses
    MultiPetScheduler --> Pet : schedules
    MultiPetScheduler --> Task : processes
    MultiPetScheduler --> MultiPetPlan : creates
    MultiPetScheduler ..> ConflictDetection : consults
    MultiPetPlan --> Task : references
    MultiPetPlan --> Pet : references

    Scheduler --> Owner : uses
    Scheduler --> Pet : uses
    Scheduler --> Task : processes
    Scheduler --> DailyPlan : creates
    DailyPlan --> Task : references

    TaskParser ..> LLMClient : calls
    TaskParser --> GuardrailValidator : validates via
    TaskParser --> CareCorpus : grounds via
    TaskParser --> ParsedPetResult : returns
    TaskParser --> ParsedTaskBatchResult : returns
    TaskParser --> Pet : creates
    TaskParser --> Task : creates
    GuardrailValidator --> ValidationResult : returns
    PetPhotoService --> Pet : looks up photo for